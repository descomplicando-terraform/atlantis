[Unit]
Description=Atlantis - Terraform Pull Request Automation
Documentation=https://www.runatlantis.io/docs/
After=network-online.target atlantis-env.service
Requires=atlantis-env.service

[Service]
Type=simple
User={{ atlantis_user }}
Group={{ atlantis_group }}

EnvironmentFile={{ atlantis_conf_dir }}/atlantis.env
EnvironmentFile=-{{ atlantis_conf_dir }}/atlantis.conf

Environment=ATLANTIS_DATA_DIR={{ atlantis_data_dir }}

ExecStart={{ atlantis_bin }} server
WorkingDirectory={{ atlantis_data_dir }}

Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

Restart=always
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

ReadWritePaths={{ atlantis_data_dir }}

[Install]
WantedBy=multi-user.target
